// Identify accounts receiving excessive MFA prompts (potential push bombing attack)
let startTime=ago(7d);
let endTime=ago(0d);
let MFAThreshold = 10;
let TimeWindowMinutes = 15;
AADSignInEventsBeta
| where Timestamp between (startTime .. endTime)
| where ErrorCode in (50074, 50076, 500121) // MFA-related codes
| summarize 
    MFAAttempts = count(),
    FirstAttempt = min(Timestamp),
    LastAttempt = max(Timestamp),
    IPAddresses = make_set(IPAddress)
    by AccountUpn, bin(Timestamp, 15m)
| where MFAAttempts >= MFAThreshold
| order by MFAAttempts desc